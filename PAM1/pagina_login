class MainActivity : ComponentActivity() {

    @OptIn(ExperimentalMaterial3Api::class) // Resolve o erro de API Experimental
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()

        setContent {
            AppBasicKotlinTheme {
                val navController = rememberNavController()

                // O Scaffold fornece a estrutura básica (TopBar, BottomBar, etc)
                Scaffold(modifier = Modifier.fillMaxSize()) { innerPadding ->

                    // O NavHost gerencia a navegação entre as telas
                    // Adicionamos o modifier.padding(innerPadding) para respeitar as margens do sistema
                    NavHost(
                        navController = navController,
                        startDestination = "login",
                        modifier = Modifier.padding(innerPadding)
                    ) {

                        // Tela de Login
                        composable("login") {
                            LoginScreen(
                                onLogin = { userName ->
                                    navController.navigate("home/${userName.ifBlank { "Convidado" }}")
                                },
                                onRegisterClick = {
                                    navController.navigate("register")
                                }
                            )
                        }

                        // Tela de Registro de Usuário
                        composable("register") {
                            RegisterScreen(
                                onRegisterComplete = {
                                    navController.popBackStack()
                                }
                            )
                        }

                        // Tela Home com argumento (Nome do Usuário)
                        composable(
                            route = "home/{userName}",
                            arguments = listOf(navArgument("userName") {
                                type = NavType.StringType
                            })
                        ) { backStackEntry ->
                            val userName = backStackEntry.arguments?.getString("userName") ?: "Usuário"

                            HomeScreen(
                                userName = userName,
                                onCadastrarProduto = {
                                    navController.navigate("cadastrarProduto")
                                },
                                onListarProdutos = {
                                    navController.navigate("listarProdutos")
                                },
                                onLogout = {
                                    // Volta para o login limpando a pilha de telas
                                    navController.navigate("login") {
                                        popUpTo("login") { inclusive = true }
                                    }
                                }
                            )
                        }

                        // Tela de Cadastro de Produto
                        composable("cadastrarProduto") {
                            CadastrarProdutoScreen(
                                onRegisterComplete = {
                                    navController.popBackStack()
                                }
                            )
                        }

                        // Tela de Listagem de Produtos
                        composable("listarProdutos") {
                            ListarProdutosScreen(
                                onBack = {
                                    navController.popBackStack()
                                }
                            )
                        }
                    }
                }
            }
        }
    }
}
