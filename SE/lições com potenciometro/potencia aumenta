const int potenciometro = A0;
const int leds[] = {2, 3, 4, 5, 6, 7};
const int tantosleds = 6;

void setup() {
  for (int i = 0; i < tantosleds; i++) {
    pinMode(leds[i], OUTPUT);
  }
  Serial.begin(9600);
}
void loop() {
  int valor = analogRead(potenciometro);
  Serial.println(valor);
  
  int acenderled = map(valor, 0, 1023, 0, tantosleds);
  
  for (int i = 0; i < tantosleds; i++) {
    if (i < acenderled) {
      digitalWrite(leds[i], HIGH);
    } else {
      digitalWrite(leds[i], LOW);
    }
  }
  
  delay(50);
}
