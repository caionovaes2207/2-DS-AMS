#include <Keypad.h>
#include <Servo.h>
Servo cancela;


String senhaCorreta = "1";
String senhaDigitada = "";
const int ledVerde = 11;
const int ledVermelho = 12;
const int servoPin = 10;
const byte LINHAS = 4;
const byte COLUNAS = 4;

char teclas[LINHAS][COLUNAS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};


byte pinosLinhas[LINHAS] = {9, 8, 7, 6};
byte pinosColunas[COLUNAS] = {5, 4, 3, 2};

Keypad teclado = Keypad(
  makeKeymap(teclas),
  pinosLinhas,
  pinosColunas,
  LINHAS,
  COLUNAS
);

void setup() {

  pinMode(ledVerde, OUTPUT);
  pinMode(ledVermelho, OUTPUT);

  digitalWrite(ledVermelho, HIGH);
  digitalWrite(ledVerde, LOW);

  cancela.attach(servoPin);
  cancela.write(0);

  Serial.begin(9600);
  Serial.println("Sistema de Cancela");
}

void loop() {

  char tecla = teclado.getKey();

  if (tecla) {

    Serial.print(tecla);

    if (tecla == '4') {

      if (senhaDigitada == senhaCorreta) {

        Serial.println("\nAcesso Liberado");

        digitalWrite(ledVermelho, LOW);
        digitalWrite(ledVerde, HIGH);

        cancela.write(90);
        delay(3000);
        digitalWrite(ledVermelho, LOW);
        digitalWrite(ledVerde, HIGH);

        delay(5000);

        cancela.write(0);
        delay(1000);
        digitalWrite(ledVermelho, HIGH);
        digitalWrite(ledVerde, LOW);


        digitalWrite(ledVerde, LOW);
        digitalWrite(ledVermelho, HIGH);

      } else {

        Serial.println("\nSenha Incorreta");
      }

      senhaDigitada = "";
    }

    else if (tecla == '*') {

      senhaDigitada = "";
      Serial.println("\nSenha Apagada");
    }

    else {

      senhaDigitada += tecla;
    }
  }
}
